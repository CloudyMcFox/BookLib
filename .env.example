# Secret used to sign JWT access tokens. Generate your own, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string

# How long an access token stays valid, in minutes (default 480 = 8 hours).
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Guests can browse and search the library without an account, but cannot add,
# edit or delete anything. Set to false to remove the "Browse as guest" button
# and the endpoint behind it.
GUEST_ACCESS_ENABLED=true

# How long a guest session lasts, in minutes. Kept short because the token is
# handed out without any credentials.
GUEST_TOKEN_EXPIRE_MINUTES=120

# Google Books is used as a fallback when OpenLibrary has no genres, cover or
# metadata for a book. A key is optional but recommended: without one Google
# shares a per-IP anonymous quota that is often already exhausted, and calls
# just return HTTP 429. Create one at https://console.cloud.google.com/ by
# enabling the "Books API" and making an API key.
GOOGLE_BOOKS_API_KEY=

# Set to false to disable the Google Books fallback entirely.
GOOGLE_BOOKS_ENABLED=true

# Size of the single shelf seeded on first start. Shelves are managed in the app
# afterwards, so these only matter for a brand new database.
DEFAULT_SHELF_COLUMNS=6
DEFAULT_SHELF_ROWS=8

# Host ports published by docker compose
BACKEND_PORT=8882
FRONTEND_PORT=3006

# Backend URL baked into the frontend bundle at build time.
# Leave empty when a reverse proxy serves the UI and API from the same origin.
# Otherwise point it at the API, e.g. https://api.example.com
VITE_API_BASE=
