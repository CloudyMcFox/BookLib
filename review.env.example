# Copy this file to .env.review on the server. Never commit .env.review.

# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=480
GUEST_ACCESS_ENABLED=false
GUEST_TOKEN_EXPIRE_MINUTES=120

GOOGLE_BOOKS_API_KEY=
GOOGLE_BOOKS_ENABLED=true

DEFAULT_SHELF_COLUMNS=6
DEFAULT_SHELF_ROWS=8

REVIEW_BACKEND_PORT=8889
REVIEW_FRONTEND_PORT=3010

# Same-origin nginx proxying means no browser CORS origin or baked API URL is
# needed for the review environment.
CORS_ORIGINS=
VITE_API_BASE=
